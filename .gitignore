.agent-discipline.json

# Third-party corpus rows carry em dashes and a decade apostrophe the punctuation gate blocks,
# and editing them would break the byte-for-byte rebuild the calibration depends on.
# Rebuild with: python3 evals/build_slop_corpora.py
hooks/lib/corpus_slop_*.jsonl

# 60000 sentences of third-party prose, too large to review in a diff and rebuildable byte for byte.
# Rebuild with: python3 evals/build_human_corpus.py
evals/corpus_human_sentences.jsonl
evals/corpus_ai_sentences.jsonl

# 9256 third-party documents that still carry their paragraph breaks, 27MB and rebuildable byte for byte.
# Rebuild with: python3 evals/build_paragraph_corpus.py
evals/corpus_paragraphs.jsonl

# Third-party sentences again, rebuilt byte for byte from the corpus above.
# Rebuild with: python3 evals/build_pattern_benchmark.py
evals/benchmark_patterns.jsonl

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" SessionStart",
            "statusMessage": "Loading agent discipline watcher"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" SubagentStop",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" Stop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ADW_CODEX_HOOK=1 \"__SKILL_DIR__/hooks/run.sh\" SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

#!/bin/sh
set -eu

[ "$#" -eq 1 ] || {
  echo "usage: adw-judge mixed|luna|haiku|sonnet|status" >&2
  exit 2
}
case "$1" in
  mixed|luna|haiku|sonnet|status) ;;
  *)
    echo "adw-judge: invalid preset: $1" >&2
    exit 2
    ;;
esac

DIR="$(cd "$(dirname "$0")/.." && pwd)"
. "$DIR/hooks/resolve-python.sh"
read -r FLOOR < "$DIR/.python-version"
PYTHON="$(adw_resolve_python "$FLOOR")"
[ -n "$PYTHON" ] || {
  echo "adw-judge: no Python $FLOOR or newer on PATH. Install one, or point ADW_PYTHON at it." >&2
  exit 2
}
PYTHONPATH="$DIR/hooks${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m lib.claude_native "$1"

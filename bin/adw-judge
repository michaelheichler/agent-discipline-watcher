#!/bin/sh
set -eu

[ "$#" -eq 1 ] || {
  echo "usage: adw-judge haiku|mixed|luna|luna-native|status" >&2
  exit 2
}
case "$1" in
  haiku|mixed|luna|luna-native|status) ;;
  *)
    echo "adw-judge: invalid preset: $1" >&2
    exit 2
    ;;
esac

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(CDPATH= cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
  esac
done
DIR="$(CDPATH= cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
. "$DIR/hooks/resolve-python.sh"
read -r FLOOR < "$DIR/.python-version"
PYTHON="$(adw_resolve_python "$FLOOR")"
[ -n "$PYTHON" ] || {
  echo "adw-judge: no Python $FLOOR or newer on PATH. Install one, or point ADW_PYTHON at it." >&2
  exit 2
}
PYTHONPATH="$DIR/hooks${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m lib.claude_native "$1"

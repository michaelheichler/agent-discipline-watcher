#!/usr/bin/env python3
import argparse
import json
import sys
from pathlib import Path


# Resolve through the script's real path, because install.sh symlinks this file into ~/.local/bin.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))

from lib import config, reporting, review  # noqa: E402


CHECKS = config.GATE_FAMILIES


def project_root(path):
    root = Path(path).expanduser().resolve()
    if not root.exists():
        raise SystemExit(f"project path does not exist: {root}")
    if not root.is_dir():
        raise SystemExit(f"project path is not a directory: {root}")
    return root


def config_path(root):
    return root / config.CONFIG_NAME


def parse_checks(raw):
    enabled = set()
    for part in raw.split(","):
        name = part.strip()
        if name:
            enabled.add(name)
    unknown = sorted(enabled - set(CHECKS))
    if unknown:
        raise SystemExit(f"unknown check: {', '.join(unknown)}")
    return {name: name in enabled for name in CHECKS}


def parse_selected_checks(raw, current):
    choice = raw.strip().lower()
    if not choice:
        return dict(current)
    if choice == "all":
        return {name: True for name in CHECKS}
    if choice == "none":
        return {name: False for name in CHECKS}

    selected = set()
    for part in choice.replace(",", " ").split():
        if not part.isdigit():
            raise SystemExit(f"unknown selection: {part}")
        number = int(part)
        if number < 1 or number > len(CHECKS):
            raise SystemExit(f"unknown selection: {part}")
        selected.add(CHECKS[number - 1])
    return {name: name in selected for name in CHECKS}


def read_raw(path):
    """Return the whole config object, so that a rewrite preserves keys this CLI does not own."""
    if not path.exists():
        return {}
    data = json.loads(path.read_text())
    return data if isinstance(data, dict) else {}


def write_raw(root, data):
    config_path(root).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")


def load_config(root):
    """Resolve through flatten_settings over DEFAULTS, because a top-level key overrides the checks block for the gate too."""
    path = config.project_config_path(root)
    settings = config.effective_config(cwd=root)
    families = settings.get("exempt_families")
    return {
        "project": str(root),
        "config_path": str(path),
        "checks": {name: bool(settings.get(name, True)) for name in CHECKS},
        "exempt_families": families if isinstance(families, dict) else {},
    }


def choose_checks(root):
    current = load_config(root)["checks"]
    print("Select checks:")
    for number, name in enumerate(CHECKS, start=1):
        state = "on" if current[name] else "off"
        print(f"{number}. {name} [{state}]")
    try:
        raw = input("Numbers, all, none, or Enter: ")
    except EOFError:
        raw = ""
    return parse_selected_checks(raw, current)


def _refuse_shadow(root, own_path):
    """Block a write here when an ancestor config exists, because a subdirectory config would silently drop the inherited settings."""
    if own_path.exists():
        return
    found = config.project_config_path(root)
    if found != own_path:
        raise SystemExit(
            f"refusing to create {own_path}: it would shadow the existing config at {found}. "
            "Edit that file directly, or run this command from a project with no ancestor config."
        )


def configure(args):
    root = project_root(args.project)
    own_path = config_path(root)
    _refuse_shadow(root, own_path)
    checks = choose_checks(root) if args.checks is None else parse_checks(args.checks)
    data = read_raw(own_path)
    data["checks"] = checks
    for name in CHECKS:
        data.pop(name, None)
    write_raw(root, data)
    print(json.dumps(load_config(root), indent=2, sort_keys=True))


def parse_families(raw):
    names = {part for part in raw.replace(",", " ").split() if part}
    unknown = sorted(names - set(CHECKS))
    if unknown:
        raise SystemExit(f"unknown family: {', '.join(unknown)}")
    if not names:
        raise SystemExit("name at least one family, or pass --clear")
    return sorted(names)


def exempt_family(args):
    root = project_root(args.project)
    own_path = config_path(root)
    _refuse_shadow(root, own_path)
    data = read_raw(own_path)
    current = data.get("exempt_families")
    mapping = dict(current) if isinstance(current, dict) else {}
    if args.clear:
        mapping.pop(args.pattern, None)
    else:
        mapping[args.pattern] = parse_families(args.families or "")
    data["exempt_families"] = mapping
    write_raw(root, data)
    print(json.dumps(load_config(root), indent=2, sort_keys=True))


def status(args):
    root = project_root(args.project)
    print(json.dumps(load_config(root), indent=2, sort_keys=True))


def _ledger_path(root):
    return reporting._ledger_dir(root) / reporting.LEDGER_FILENAME


def require_ledger(root):
    """Raise before any parse, because a caller that only needs to know the ledger exists should not pay for reading it."""
    path = _ledger_path(root)
    if not path.exists():
        raise SystemExit(f"no ledger at {path}")
    return path


def observe_report(args):
    project_root(args.project)
    require_ledger(args.root)
    try:
        rows = reporting.observe_report(args.family, args.root)
    except OSError as exc:
        raise SystemExit(f"cannot read ledger at {_ledger_path(args.root)}: {exc}")
    if not rows:
        print(f"{args.family}: no would_block rows recorded")
        return
    for row in sorted(rows, key=lambda item: str(item.get("ts", ""))):
        print(
            f"{row.get('ts')}\tturn={row.get('turn_id')}\t"
            f"{row.get('rule')}\t{row.get('path')}"
        )


def false_signal_rate(args):
    project_root(args.project)
    require_ledger(args.root)
    rate = reporting.false_signal_rate(args.family, args.root)
    if rate is None:
        print(f"{args.family}: below the 20-turn floor, no rate yet")
        return
    print(f"{args.family}: false-signal rate per 20 turns = {rate:.2f}")


def adjudicate(args):
    project_root(args.project)
    reporting.adjudicate(args.family, args.ref_ts, args.justified, args.root)
    verdict = "justified" if args.justified else "false-signal"
    print(f"adjudicated {args.family} {args.ref_ts} as {verdict}")


def add_reporting_parsers(sub):
    """Keep the three burn-in subcommands together, so main() stays under the function length gate."""
    observe = sub.add_parser("observe-report")
    observe.add_argument("family")
    observe.add_argument("project", nargs="?", default=".")
    observe.add_argument("--root", help="ledger directory")
    observe.set_defaults(func=observe_report)

    rate = sub.add_parser("false-signal-rate")
    rate.add_argument("family")
    rate.add_argument("project", nargs="?", default=".")
    rate.add_argument("--root", help="ledger directory")
    rate.set_defaults(func=false_signal_rate)

    judge = sub.add_parser("adjudicate")
    judge.add_argument("family")
    judge.add_argument("ref_ts")
    judge.add_argument("project", nargs="?", default=".")
    judge.add_argument("--root", help="ledger directory")
    label = judge.add_mutually_exclusive_group(required=True)
    label.add_argument("--justified", dest="justified", action="store_true")
    label.add_argument("--false-signal", dest="justified", action="store_false")
    judge.set_defaults(func=adjudicate)


def dispatch(parser, args):
    """Map review input and file errors to the documented usage status."""
    try:
        result = args.func(args)
    except (OSError, ValueError) as exc:
        parser.error(str(exc))
    return result if isinstance(result, int) else 0


def build_parser():
    """Build one parser so subprocess and direct-call behavior stay aligned."""
    parser = argparse.ArgumentParser(prog="agent-discipline")
    sub = parser.add_subparsers(dest="command", required=True)

    configure_parser = sub.add_parser("configure")
    configure_parser.add_argument("project", nargs="?", default=".")
    configure_parser.add_argument(
        "--checks",
        help="comma list: punctuation,english,clean_code",
    )
    configure_parser.set_defaults(func=configure)

    exempt_parser = sub.add_parser("exempt-family")
    exempt_parser.add_argument("pattern")
    exempt_parser.add_argument("project", nargs="?", default=".")
    exempt_parser.add_argument(
        "--families",
        help="comma list of families to drop on this path: punctuation,english,clean_code",
    )
    exempt_parser.add_argument("--clear", action="store_true")
    exempt_parser.set_defaults(func=exempt_family)

    status_parser = sub.add_parser("status")
    status_parser.add_argument("project", nargs="?", default=".")
    status_parser.set_defaults(func=status)

    add_reporting_parsers(sub)
    review.add_review_parser(sub)
    return parser


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv:
        status(argparse.Namespace(project="."))
        print("Hint: run agent-discipline configure to choose checks.")
        return 0

    parser = build_parser()
    args = parser.parse_args(argv)
    return dispatch(parser, args)


if __name__ == "__main__":
    raise SystemExit(main())
